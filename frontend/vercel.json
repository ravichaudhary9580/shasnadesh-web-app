{
  
  "rewrites": [
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "query",
          "key": "ssr",
          "value": "true"
        }
      ],
      "destination": "https://shasnadesh-web-app.vercel.app/api/blogs/og/:slug"
    },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(googlebot|adsbot|mediapartners-google|feedfetcher-google|bingbot|bingpreview|yandex|baiduspider|duckduckbot|slurp|facebookexternalhit|WhatsApp|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|applebot|petalbot|semrushbot|ahrefsbot|rogerbot|exabot|screaming|lighthouse|headlesschrome|curl|wget|postman).*"
        }
      ],
      "destination": "https://shasnadesh-web-app.vercel.app/api/blogs/og/:slug"
    },
    {
      "source": "/sitemap-blogs.xml",
      "destination": "https://shasnadesh-web-app.vercel.app/api/sitemap/blogs.xml"
    },
    {
      "source": "/sitemap-index.xml",
      "destination": "https://shasnadesh-web-app.vercel.app/api/sitemap/index.xml"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sitemap-blogs.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/sitemap-index.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
